PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/subscriptions
MONGO_DB=
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES=7d
CLIENT_URL=http://localhost:5173

# Billing cron schedule (default: daily at 02:00). Empty = disabled.
BILLING_CRON=0 2 * * *

# Optional SMTP for password resets + invoice emails (logs to console if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
