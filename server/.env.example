# Copy to .env and fill in. Never commit the real .env.
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/subscriptions
# Local dev without Postgres: DATABASE_URL=sqlite:///./dev.db

JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false

# Optional: without SMTP_* the reset link is printed to the server console.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.com
